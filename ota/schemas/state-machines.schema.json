{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-gatekeeper.invalid/schemas/state-machines.schema.json",
  "title": "Smart Gatekeeper OTA state machines",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "mobile"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"$ref": "#/$defs/stateMachine"},
    "mobile": {"$ref": "#/$defs/stateMachine"}
  },
  "$defs": {
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial", "states", "terminal_success", "failure_preserves",
        "invariants"
      ],
      "properties": {
        "initial": {"type": "string", "minLength": 1},
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "terminal_success": {"type": "string", "minLength": 1},
        "failure_preserves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
