# Copy to the root-owned NAS deployment directory as runtime.env.
# This file contains identifiers and paths only. Passwords, API keys, private
# scalars and certificates are individual files below SGK_SECRET_DIR.

MQTT_HOST=broker.example.invalid
MQTT_PORT=4883
MQTT_USER=replace-with-runtime-principal
DB_RUNTIME_USER=replace-with-existing-db-user
COMMAND_TARGET_ID=replace-target-id
COMMAND_TENANT_ID=replace-tenant-id
COMMAND_DOOR_ID=replace-door-id
COMMAND_SIGNING_KEY_ID=1
ADMIN_TRUSTED_PROXY_IPS=127.0.0.1
ACL_SIGNING_KEY_ID=1
HA_BRIDGE_ENABLED=false
HA_BRIDGE_ALLOW_MANUAL_REMOTE=false
HA_BRIDGE_STATUS_MAX_AGE_SECONDS=15
# Keep false for Backend N / Target N-1. Change to true only after Target N
# install/reboot/health and matching signed-status observation.
ACCESS_SIGNED_STATUS_READINESS_REQUIRED=false
# Reviewed personal Target evidence semantics: signed status freshness is 5 s
# and the active-LOW relay is OFF/High-Z when the observed pin level is HIGH.
ACCESS_STATUS_MAX_AGE_SECONDS=5
TARGET_RELAY_OFF_PIN_LEVEL=1
ACL_PERSONAL_ENROLLMENT_ENABLED=false
ACL_PERSONAL_TENANT_ID=
ACL_PERSONAL_DOOR_ID=

SGK_API_LOOPBACK_PORT=8000
SGK_SECRET_DIR=/volume1/docker/smart-gatekeeper-backend/secrets
SGK_PUBLIC_READY_URL=https://example.invalid:4442/ready

# All four volumes must exist before deployment. MARIADB_DATA_VOLUME must name
# the existing production DB volume during first adoption; never guess it.
MARIADB_DATA_VOLUME=replace-existing-mariadb-volume
API_STATE_VOLUME=smart-gatekeeper-api-state
APK_ARTIFACTS_VOLUME=smart-gatekeeper-apk-artifacts
MIGRATION_BACKUPS_VOLUME=smart-gatekeeper-migration-backups
