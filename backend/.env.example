# backend/.env.example
# =============================================================
# smart-gatekeeper 백엔드 환경변수 예시
# 실제 배포 시 이 파일을 복사하여 .env로 저장 후 값을 채우세요.
# .env 파일은 절대 Git에 커밋하지 마십시오 (.gitignore 확인)
# =============================================================

# ── MariaDB 설정 ───────────────────────────────────────────────
DB_ROOT_PASSWORD=your_root_password_here
DB_NAME=smart_gatekeeper
DB_USER=gatekeeper_user
DB_PASSWORD=your_db_password_here

# ── MQTT 브로커 설정 (v2.0 — gatekeeper/arm Pre-arm 발행용) ──
# 시놀로지 NAS에서 실행 중인 MQTT 브로커 주소
MQTT_HOST=your-nas.synology.me
MQTT_PORT=8883
MQTT_USER=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
# TLS 사용 여부 (시놀로지 NAS 자체 서명 인증서는 true)
MQTT_USE_TLS=true
# ESP32-C6가 구독 중인 토픽 (config.h의 MQTT_TOPIC_ARM과 일치해야 함)
MQTT_TOPIC_ARM=gatekeeper/arm

# ── 모바일 앱 Remote Config ────────────────────────────────────
# ESP32-C6가 발신하는 iBeacon UUID (include/config.h와 일치해야 함)
GATEKEEPER_BEACON_UUID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
# 앱 Pre-arm 쿨다운 기본값(초).
# 앱은 이 값을 "기본값"으로만 사용하며, 사용자가 디버그 화면에서 직접
# 조정한 적이 있으면 단말의 로컬 설정을 우선한다.
APP_COOLDOWN_SEC=10

# ── 문 제어 API 인증 키 (issue.md P3-22) ───────────────────────
# /api/v1/door/prearm 의 X-API-KEY 검증과, 관리자 콘솔 "마스터 개방"에 쓰인다.
#
# ⚠️ 배포 순서를 반드시 지키십시오. 순서를 바꾸면 세입자 출입이 막힙니다.
#   1) GitHub Secrets 에 GATEKEEPER_API_KEY 를 같은 값으로 등록
#   2) 앱을 재빌드/배포하고 세입자들이 업데이트를 마칠 때까지 기다린다
#   3) 그 다음에 이 값을 서버에 설정하고 컨테이너를 재시작한다
#
# 비워 두면 키 인증이 비활성된다(기동 시 경고 로그). 이 상태에서도
# 미등록/미승인 기기 거부와 DB 장애 시 fail-closed 는 계속 동작하지만,
# 관리자 마스터 개방은 사용할 수 없다.
#
# 생성 예: openssl rand -hex 32
GATEKEEPER_API_KEY=

# ── Issue #19 Hardwareless RC ACL management plane ─────────────
# Keep false until the expand migration is applied and N/N-1 clients are ready.
ACL_MANAGEMENT_ENABLED=false
# Migration lookup only. This never makes device_id an ACL authorization credential.
ACL_LEGACY_DEVICE_LOOKUP_ENABLED=true
# Independent random HMAC key for one-way legacy device reference migration only.
ACL_LEGACY_REF_HMAC_KEY=
# Actor-keyed login-bridge credentials bind each enrollment identity to one tenant.
ACL_ENROLLMENT_AUTH_JSON={}
ACL_ADMIN_API_KEY=
# Map Target identity to tenant, one authorized door, and management credential so pull/ACK/health
# identity cannot be forged or used to cross a door boundary in the same tenant.
ACL_TARGET_AUTH_JSON={}
# Hardwareless RC signer input. Production must replace this with an isolated HSM/KMS signer.
# Never print, commit, or expose this value through an API.
ACL_SIGNING_PRIVATE_SCALAR_HEX=
ACL_SIGNING_KEY_ID=1
# Optional transition signer. Configure both values together. Keep the N-1 signer primary
# until every Target trusts the transition key; the envelope is dual-signed during rollout.
ACL_TRANSITION_SIGNING_PRIVATE_SCALAR_HEX=
ACL_TRANSITION_SIGNING_KEY_ID=
# Protocol default 900 seconds; hard maximum 3600 seconds.
ACL_LEASE_SECONDS=900
