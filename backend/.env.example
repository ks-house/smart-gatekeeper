# backend/.env.example
# =============================================================
# smart-gatekeeper 백엔드 환경변수 예시
# 실제 배포 시 이 파일을 복사하여 .env로 저장 후 값을 채우세요.
# .env 파일은 절대 Git에 커밋하지 마십시오 (.gitignore 확인)
# =============================================================

# ── MariaDB 설정 ───────────────────────────────────────────────
DB_ROOT_PASSWORD=your_root_password_here
DB_NAME=smart_gatekeeper
DB_USER=gatekeeper_user
DB_PASSWORD=your_db_password_here

# ── MQTT 브로커 설정 (v2.0 — gatekeeper/arm Pre-arm 발행용) ──
# 시놀로지 NAS에서 실행 중인 MQTT 브로커 주소
MQTT_HOST=your-nas.synology.me
MQTT_PORT=8883
MQTT_USER=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
# TLS 사용 여부 (시놀로지 NAS 자체 서명 인증서는 true)
MQTT_USE_TLS=true
# ESP32-C6가 구독 중인 토픽 (config.h의 MQTT_TOPIC_ARM과 일치해야 함)
MQTT_TOPIC_ARM=gatekeeper/arm
