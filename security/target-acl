# Reference only: render with scripts/render_broker_acl.py and a private inventory.
# Never copy this example directly over a running broker ACL.
# Named Target users receive only their own explicit namespace. Global pattern
# rules are forbidden because Mosquitto applies them to every named principal.
user target-example
topic read gatekeeper/v1/targets/target-example/command
topic read gatekeeper/v1/targets/target-example/acl
topic write gatekeeper/v1/targets/target-example/command-ack
topic write gatekeeper/v1/targets/target-example/acl/ack
topic write gatekeeper/v1/targets/target-example/availability
topic write gatekeeper/v1/targets/target-example/status
topic write gatekeeper/v1/targets/target-example/event
topic write gatekeeper/v1/targets/target-example/canonical-event
topic write gatekeeper/v1/targets/target-example/sensor
topic write gatekeeper/v1/targets/target-example/boot
topic write gatekeeper/v1/targets/target-example/config-state

# Backend/release identities are provisioned explicitly, never by wildcard
# Target credentials. The renderer replaces these named role examples.
user gatekeeper-backend
topic write gatekeeper/v1/targets/+/command
topic write gatekeeper/v1/targets/+/acl
topic read gatekeeper/v1/targets/+/command-ack
topic read gatekeeper/v1/targets/+/acl/ack
topic read gatekeeper/v1/targets/+/boot
topic read gatekeeper/v1/targets/+/status
topic read gatekeeper/v1/targets/+/availability
topic read gatekeeper/v1/targets/+/canonical-event
topic read gatekeeper/v1/ha-bridge/+/request/+
topic read gatekeeper/v1/ha-bridge/+/access-event
topic write gatekeeper/v1/ha-bridge/+/availability
topic write gatekeeper/v1/ha-bridge/+/result
topic write gatekeeper/v1/ha-bridge/+/verified-status
topic write gatekeeper/v1/ha-bridge/+/connectivity-diagnostic
topic write gatekeeper/v1/ha-bridge/+/access-event
topic write homeassistant/button/smart_gatekeeper_01/+/config
topic write homeassistant/number/smart_gatekeeper_01/+/config
topic write homeassistant/sensor/smart_gatekeeper_01/+/config
topic write homeassistant/binary_sensor/smart_gatekeeper_01/+/config
topic write homeassistant/event/smart_gatekeeper_01/+/config

# Home Assistant can observe discovery/state and request only the backend
# bridge. It can never publish a Target command or ACL directly.
user homeassistant
topic read homeassistant/#
topic readwrite homeassistant/status
# Diagnostics/config values are broker-principal authenticated after the
# production ACL cutover. Access/relay readiness consumes verified-status.
topic read gatekeeper/v1/targets/+/status
topic read gatekeeper/v1/ha-bridge/+/availability
topic read gatekeeper/v1/ha-bridge/+/result
topic read gatekeeper/v1/ha-bridge/+/verified-status
topic read gatekeeper/v1/ha-bridge/+/connectivity-diagnostic
topic read gatekeeper/v1/ha-bridge/+/access-event
topic write gatekeeper/v1/ha-bridge/+/request/+
