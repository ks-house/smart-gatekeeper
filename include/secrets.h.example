// include/secrets.h.example
// =============================================================
// smart-gatekeeper — 보안 민감 정보 템플릿 예시 파일
// =============================================================
#pragma once

// Wi-Fi 접속 정보
#define SECRET_WIFI_SSID "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// 시놀로지 NAS API 보안 키 및 주소
#define SECRET_API_URL "https://tworimpa.synology.me:4442/api/v1/auth/verify"
#define SECRET_API_KEY "your_secret_api_key"

// 테스트용 디바이스 BLE MAC
#define SECRET_TEST_BLE_MAC "AA:BB:CC:DD:EE:01"

// MQTT 브로커 설정 (시놀로지 NAS Mosquitto)
#define SECRET_MQTT_HOST "tworimpa.synology.me"
#define SECRET_MQTT_PORT 1883
#define SECRET_MQTT_USER "gatekeeper_mqtt"
#define SECRET_MQTT_PASSWORD "gatekeeper_mqtt_pass"

// OTA (Over-The-Air) 배포 주소
#define SECRET_OTA_VERSION_URL "https://tworimpa.synology.me:4442/firmware/version.json"
#define SECRET_OTA_FIRMWARE_URL "https://tworimpa.synology.me:4442/firmware/gatekeeper-firmware.bin"
