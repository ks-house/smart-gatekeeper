{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-gatekeeper.local/schemas/issue54-evidence-v1.json",
  "title": "Issue 54 physical gate evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_version", "candidate", "records"],
  "properties": {
    "schema_version": {"const": "issue54-physical-evidence/v1"},
    "plan_version": {"const": "issue54-physical-gate-plan/v1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "firmware_artifact_sha256", "mobile_artifact_sha256"],
      "properties": {
        "git_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "firmware_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mobile_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "executed_trials", "passed_trials", "failed_trials", "raw_evidence", "operator_approval", "notes"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["not_run", "passed", "failed", "aborted"]},
        "executed_trials": {"type": "integer", "minimum": 0},
        "passed_trials": {"type": "integer", "minimum": 0},
        "failed_trials": {"type": "integer", "minimum": 0},
        "raw_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "operator_approval": {"type": ["object", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}
