{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-gatekeeper.local/schemas/issue54-evidence-v2.json",
  "title": "Issue 54 physical gate evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_version", "candidate", "records"],
  "properties": {
    "schema_version": {"const": "issue54-physical-evidence/v2"},
    "plan_version": {"const": "issue54-physical-gate-plan/v2"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha", "firmware_artifact_sha256", "mobile_artifact_sha256"],
      "properties": {
        "git_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "firmware_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mobile_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity_id"],
      "properties": {
        "name": {"type": "string", "pattern": "^.*\\S.*$"},
        "identity_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "executor"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "executor": {"$ref": "#/$defs/identity"}
      }
    },
    "raw_evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "immutable_locator", "capture_id", "captured_at", "captured_by", "sha256"],
      "properties": {
        "category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "immutable_locator": {"type": "string", "pattern": "^urn:sha256:[0-9a-f]{64}$"},
        "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "captured_by": {"$ref": "#/$defs/identity"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reviewer", "timestamp", "decision"],
      "properties": {
        "role": {
          "enum": ["independent_reviewer", "risk_owner", "operator_risk_owner", "release_risk_owner"]
        },
        "reviewer": {"$ref": "#/$defs/identity"},
        "timestamp": {"type": "string", "format": "date-time"},
        "decision": {"enum": ["approved", "rejected", "incomplete"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "status",
        "pass_condition_id",
        "execution",
        "executed_trials",
        "passed_trials",
        "failed_trials",
        "raw_evidence",
        "approval",
        "notes"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["not_run", "passed", "failed", "aborted"]},
        "pass_condition_id": {"type": ["string", "null"], "pattern": "^PC-[A-Z0-9-]+-V1$"},
        "execution": {"oneOf": [{"$ref": "#/$defs/execution"}, {"type": "null"}]},
        "executed_trials": {"type": "integer", "minimum": 0},
        "passed_trials": {"type": "integer", "minimum": 0},
        "failed_trials": {"type": "integer", "minimum": 0},
        "raw_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/raw_evidence_entry"}
        },
        "approval": {"oneOf": [{"$ref": "#/$defs/approval"}, {"type": "null"}]},
        "notes": {"type": "string", "pattern": "^.*\\S.*$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_run"}}, "required": ["status"]},
          "then": {
            "properties": {
              "pass_condition_id": {"type": "null"},
              "execution": {"type": "null"},
              "executed_trials": {"const": 0},
              "passed_trials": {"const": 0},
              "failed_trials": {"const": 0},
              "raw_evidence": {"maxItems": 0},
              "approval": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "pass_condition_id": {"type": "string"},
              "execution": {"$ref": "#/$defs/execution"},
              "raw_evidence": {"minItems": 1},
              "approval": {"$ref": "#/$defs/approval"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]},
          "then": {"properties": {"approval": {"properties": {"decision": {"const": "approved"}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
          "then": {"properties": {"approval": {"properties": {"decision": {"const": "rejected"}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "aborted"}}, "required": ["status"]},
          "then": {"properties": {"approval": {"properties": {"decision": {"const": "incomplete"}}}}}
        }
      ]
    }
  }
}
