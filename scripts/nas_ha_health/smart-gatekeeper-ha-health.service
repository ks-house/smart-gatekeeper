[Unit]
Description=Smart Gatekeeper HA ingress and lifecycle observer
After=pkg-ContainerManager-dockerd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/lib/smart-gatekeeper-ha-health/monitor.py
Restart=always
RestartSec=10
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
